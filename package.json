{
  "name": "tyneq",
  "version": "1.0.0",
  "description": "Typed Enumerable Queries",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "debug": "node --inspect-brk --enable-source-maps ./node_modules/tsx/dist/cli.mjs src/dev.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisitopherus/tyneq.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/chrisitopherus/tyneq/issues"
  },
  "homepage": "https://github.com/chrisitopherus/tyneq#readme",
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
