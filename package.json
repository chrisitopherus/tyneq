{
  "name": "tyneq",
  "version": "1.0.0",
  "description": "Lazy query pipelines for TypeScript. LINQ-expressive, type-safe, and infinitely extensible.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./plugin": {
      "import": { "types": "./dist/plugin/index.d.ts", "default": "./dist/plugin/index.js" },
      "require": { "types": "./dist/plugin/index.d.cts", "default": "./dist/plugin/index.cjs" }
    },
    "./utility": {
      "import": { "types": "./dist/utility/index.d.ts", "default": "./dist/utility/index.js" },
      "require": { "types": "./dist/utility/index.d.cts", "default": "./dist/utility/index.cjs" }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && eslint src tests && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc --options typedoc.json",
    "docs:api:full": "typedoc --options typedoc.dev.json",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:build:pages": "npm run docs:api && vitepress build docs --base /tyneq/",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:build",
    "docs:publish": "npm run docs:build:pages && gh-pages -d docs/.vitepress/dist -b gh-pages",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisitopherus/tyneq.git"
  },
  "keywords": ["linq", "linq-style", "lazy", "enumerable", "sequence", "query", "query-builder", "pipeline", "iterator", "functional", "functional-programming", "streams", "typescript"],
  "author": "chrisitopherus",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": ["./dist/index.js", "./dist/index.cjs"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/chrisitopherus/tyneq/issues"
  },
  "homepage": "https://github.com/chrisitopherus/tyneq#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "gh-pages": "^6.3.0",
    "jiti": "^2.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18"
  }
}
